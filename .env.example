# Database Configuration
# For local development, use: postgresql://user:password@localhost:5432/cookbook_db
# For production, use your hosted database connection string (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/cookbook_db"

# Admin Authentication
# Username for admin login
ADMIN_USERNAME="admin"

# Bcrypt hashed password (generate using: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('your-password', 10).then(hash => console.log(hash))")
ADMIN_PASSWORD_HASH="your_bcrypt_hashed_password"

# JWT Secret (required)
# Use a long random secret of at least 32 characters
# Generate using: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Supabase (recipe images — Storage + public URLs)
# Project Settings → API: Project URL and service_role key (server-only; never expose to the client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# In Supabase Dashboard: Storage → create a public bucket named exactly: recipe-images
